# Copy to .env and fill in the values you actually use.
# Leave unused brokers blank.
# Leave the Python path overrides blank to auto-detect `apex-python/.venv/bin/python`
# (or fall back to `python3` if no local virtualenv exists).

APEX_STRATEGY_PYTHON_PATH=
APEX_ML_PYTHON_PATH=
APEX_SIDECAR_SOCKET=/tmp/apex_strategy.sock
APEX_LOG_LEVEL=info

# Broker and AI API keys are NOT configured here any more. Add them in the app under
# Settings > Adapters & API keys; they are stored encrypted in the credential vault and
# applied immediately. If you have an older .env with keys, unlock the vault and use
# "Import .env" in that panel once, then delete the keys from this file.

# Infrastructure
APEX_POSTGRES_URL=postgresql://apex:apex_password@localhost:5433/apex_market
APEX_REDIS_URL=redis://localhost:6380
